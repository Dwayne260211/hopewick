{
  "journal": "        <div id=\"journalWorkspace\" hidden>\n        <div id=\"journalCompose\">\n          <div class=\"field\">\n            <label for=\"jTitle\">Title <span class=\"help\">(optional)</span></label>\n            <input id=\"jTitle\" type=\"text\" maxlength=\"120\" placeholder=\"What's on your mind?\">\n          </div>\n          <div class=\"field\">\n            <label for=\"jBody\">Entry</label>\n            <textarea id=\"jBody\" rows=\"5\" maxlength=\"8000\" placeholder=\"Write freely…\"></textarea>\n          </div>\n          <div class=\"row\" style=\"margin-top:10px;gap:8px;flex-wrap:wrap\">\n            <button class=\"btn btn-primary\" type=\"button\" id=\"jSaveBtn\">Save entry</button>\n            <button class=\"btn\" type=\"button\" id=\"jRefineBtn\">Deepen reflection</button>\n            <button class=\"btn btn-ghost\" type=\"button\" id=\"jCancelEdit\" hidden>Cancel edit</button>\n          </div>\n          <div id=\"jRefineOut\" hidden></div>\n        </div>\n        <h2 style=\"font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:18px 0 8px\">Your entries</h2>\n        <ul class=\"journal-list\" id=\"journalList\" aria-label=\"Journal entries\"></ul>\n        </div>",
  "resume": "        <div id=\"resumeBuilder\" hidden>\n        <p class=\"resume-note\" id=\"resumeGapNote\">A gap in paid work is ordinary. Volunteering, courses, casual work, and caring for someone all belong here. You do not have to mention recovery unless you want to.</p>\n        <div class=\"resume-steps\" id=\"resumeSteps\" role=\"tablist\" aria-label=\"Resume steps\"></div>\n        <div class=\"resume-layout\">\n          <div>\n            <p class=\"resume-note\" id=\"resumeTip\"></p>\n            <div id=\"resumePanelContact\" class=\"resume-panel\" data-resume-panel=\"contact\" role=\"tabpanel\" aria-labelledby=\"resumeStep-contact\">\n              <div class=\"field\">\n                <label for=\"resumeName\">Your name</label>\n                <input id=\"resumeName\" type=\"text\" maxlength=\"80\" autocomplete=\"name\" placeholder=\"The name you want on the resume\">\n              </div>\n              <div class=\"field\">\n                <label for=\"resumePhone\">Phone <span class=\"help\">(optional)</span></label>\n                <input id=\"resumePhone\" type=\"tel\" maxlength=\"40\" autocomplete=\"tel\" placeholder=\"Mobile, if you want employers to call\">\n              </div>\n              <div class=\"field\">\n                <label for=\"resumeEmail\">Email <span class=\"help\">(optional)</span></label>\n                <input id=\"resumeEmail\" type=\"text\" inputmode=\"email\" maxlength=\"120\" autocomplete=\"email\" placeholder=\"Email, if you have one\">\n              </div>\n              <div class=\"field\">\n                <label for=\"resumeLocation\">Where you are <span class=\"help\">(optional)</span></label>\n                <input id=\"resumeLocation\" type=\"text\" maxlength=\"80\" autocomplete=\"address-level2\" placeholder=\"Suburb or town — a street address is optional\">\n              </div>\n            </div>\n            <div id=\"resumePanelSummary\" class=\"resume-panel\" data-resume-panel=\"summary\" role=\"tabpanel\" aria-labelledby=\"resumeStep-summary\" hidden>\n              <div class=\"field\">\n                <label for=\"resumeSummary\">Short summary</label>\n                <textarea id=\"resumeSummary\" rows=\"5\" maxlength=\"800\" placeholder=\"A few honest sentences about what you can offer. Plain words are perfect.\"></textarea>\n              </div>\n              <p class=\"help\" style=\"margin:12px 0 0\">Starting points — edit them so they sound like you:</p>\n              <div class=\"resume-prompts\" id=\"resumePrompts\"></div>\n            </div>\n            <div id=\"resumePanelExperience\" class=\"resume-panel\" data-resume-panel=\"experience\" role=\"tabpanel\" aria-labelledby=\"resumeStep-experience\" hidden>\n              <div id=\"resumeExpList\"></div>\n              <div class=\"row\" style=\"margin-top:10px\">\n                <button class=\"btn btn-sm\" type=\"button\" id=\"resumeAddExp\">Add another</button>\n              </div>\n            </div>\n            <div id=\"resumePanelEducation\" class=\"resume-panel\" data-resume-panel=\"education\" role=\"tabpanel\" aria-labelledby=\"resumeStep-education\" hidden>\n              <div id=\"resumeEduList\"></div>\n              <div class=\"row\" style=\"margin-top:10px\">\n                <button class=\"btn btn-sm\" type=\"button\" id=\"resumeAddEdu\">Add another</button>\n              </div>\n            </div>\n            <div id=\"resumePanelSkills\" class=\"resume-panel\" data-resume-panel=\"skills\" role=\"tabpanel\" aria-labelledby=\"resumeStep-skills\" hidden>\n              <div class=\"field\">\n                <label for=\"resumeSkills\">Skills</label>\n                <textarea id=\"resumeSkills\" rows=\"5\" maxlength=\"600\" placeholder=\"e.g. teamwork, cooking, being on time, using a phone, driving\"></textarea>\n              </div>\n              <p class=\"help\">One skill per line, or separate them with commas.</p>\n            </div>\n            <div id=\"resumePanelReferences\" class=\"resume-panel\" data-resume-panel=\"references\" role=\"tabpanel\" aria-labelledby=\"resumeStep-references\" hidden>\n              <div class=\"radio-row\" role=\"radiogroup\" aria-label=\"How to show references\">\n                <label><input type=\"radio\" name=\"resumeRefMode\" value=\"available\"> Say they are available if asked</label>\n                <label><input type=\"radio\" name=\"resumeRefMode\" value=\"list\"> List people who have already said yes</label>\n              </div>\n              <div id=\"resumeRefFields\">\n                <div id=\"resumeRefList\"></div>\n                <div class=\"row\" style=\"margin-top:10px\">\n                  <button class=\"btn btn-sm\" type=\"button\" id=\"resumeAddRef\">Add another</button>\n                </div>\n              </div>\n            </div>\n            <div class=\"row resume-actions\">\n              <button class=\"btn\" type=\"button\" id=\"resumeBack\">Back</button>\n              <button class=\"btn\" type=\"button\" id=\"resumeNext\">Next</button>\n              <button class=\"btn btn-primary\" type=\"button\" id=\"resumeDownload\">Download PDF</button>\n              <button class=\"btn btn-ghost\" type=\"button\" id=\"resumeClear\">Clear draft</button>\n            </div>\n            <p class=\"help\" id=\"resumeSaved\" aria-live=\"polite\"></p>\n          </div>\n          <aside class=\"resume-preview-wrap\" aria-label=\"Live preview\">\n            <h2>Preview</h2>\n            <div id=\"resumePreview\" class=\"resume-paper\" aria-live=\"polite\"></div>\n          </aside>\n        </div>\n        </div>",
  "goals": "    <div id=\"goalsEditor\" hidden>\n      <p class=\"help\" id=\"goalsWeekLabel\"></p>\n      <div id=\"goalsList\"></div>\n      <p class=\"help\" id=\"goalsSaved\" aria-live=\"polite\"></p>\n    </div>",
  "plans": "    <div id=\"plansWorkspace\" hidden>\n      <p class=\"help plans-note\" id=\"plansSaved\" aria-live=\"polite\"></p>\n      <div id=\"plansHub\"></div>\n      <div id=\"plansRelapse\" hidden></div>\n      <div id=\"plansExit\" hidden></div>\n    </div>"
}
