# Hopewick Plus — copy to .env and fill with Stripe test-mode values.
# Never commit real keys. .env is gitignored.

# Secret key from Stripe → Developers → API keys (test mode: sk_test_...)
STRIPE_SECRET_KEY=sk_test_replace_me

# Publishable key (pk_test_...). Safe to expose in the browser; the account
# service returns it from GET /api/billing/config. Checkout itself is server-side.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Recurring Price ID for AU$20 / month, currency AUD.
# Test price already created: price_1UKDd4PoYudRr3bcBe7IIdTH
# Live mode uses a different price id. Do not commit either key beside it.
STRIPE_PRICE_ID=price_replace_me

# Stripe → Developers → Webhooks → signing secret (whsec_...)
# Local: stripe listen --forward-to localhost:8787/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Where magic links and Checkout return URLs should point.
PUBLIC_BASE_URL=http://127.0.0.1:8787
PORT=8787

# Developer mode prints the magic link in the server log and in the app,
# so you can sign in without an email provider. Set to 0 in production.
HOPEWICK_DEV=1

# Optional real email (Resend). When both are set, sign-in links are emailed.
# Required in production (HOPEWICK_DEV=0). See SETUP.md.
# RESEND_API_KEY=re_replace_me
# MAGIC_LINK_FROM=Hopewick <hello@hopewick.com.au>

# Account file. Defaults to server/data/users.json (gitignored).
# Production on Render: /var/data/users.json
# BILLING_STORE=server/data/users.json

# Complimentary Hopewick Plus, comma-separated. Unset defaults to the founder
# address only. Do not put admin@bridge-bite-co.com here — that inbox is the
# organisations and clinics contact, and the server ignores it on this list.
# Set empty to grant complimentary Plus to nobody.
# FOUNDER_PLUS_EMAILS=dwaynesimons1990@gmail.com

# Hosted Hope (signed-in Free 20/day, Plus 200/day). Server only.
# Copy the key already configured on hopewick-api. Do not commit it.
# OPENAI_API_KEY=sk-replace-me
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Production host (set in render.yaml, not in this local file):
# NODE_ENV=production
# HOPEWICK_DEV=0
# PUBLIC_BASE_URL=https://hopewick.com.au
# HOST=0.0.0.0
# Webhook: https://hopewick.com.au/api/billing/webhook
