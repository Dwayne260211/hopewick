{
  "name": "hopewick",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "Hopewick static site plus the account and Stripe billing server.",
  "scripts": {
    "start": "node server/index.js",
    "test:billing": "node --test --test-concurrency=1 server/billing.test.mjs",
    "test:play": "node --test --test-concurrency=1 server/play-billing.test.mjs",
    "test:visits": "node --test server/visits.test.mjs",
    "test:resume": "node --test tests/resume-pdf.test.mjs",
    "test:hope": "node --test --test-concurrency=1 server/hope-safety.test.mjs",
    "test:store": "node --test --test-concurrency=1 server/store-safety.test.mjs",
    "test:brand": "node --test tests/brand-assets.test.mjs"
  }
}
